{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.4",
        "anhskohbo/no-captcha": "^3.4",
        "artesaos/seotools": "^0.19.1",
        "ctf0/media-manager": "^3.7",
        "doctrine/dbal": "^3.1",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.2",
        "hubspot/api-client": "^10.2",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^8.0",
        "laravel/jetstream": "^1.4",
        "laravel/sanctum": "^2.6",
        "laravel/socialite": "^5.1",
        "laravel/tinker": "^2.0",
        "laravelium/sitemap": "^8.0",
        "livewire/livewire": "^2.0",
        "mikemclin/laravel-wp-password": "^2.0",
        "mpdf/mpdf": "^8.0",
        "paypal/paypal-checkout-sdk": "1.0.1",
        "spatie/eloquent-sortable": "^3.10",
        "spatie/laravel-cookie-consent": "^2.12",
        "spatie/laravel-permission": "^3.17",
        "spatie/laravel-settings": "^2.3",
        "stripe/stripe-php": "^7.116",
        "timwassenburg/laravel-pivot-table-generator": "^1.0",
        "voku/simple_html_dom": "^4.7"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "facade/ignition": "^2.3.6",
        "fzaninotto/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/AppHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "app/Helpers/AppHelper.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "App\\Providers\\EventServiceProvider::postAutoloadDump"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-install-cmd": [
            "@php artisan pcl:post-install"
        ],
        "post-update-cmd": [
            "@php artisan pcl:post-update"
        ]
    }
}
