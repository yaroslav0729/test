FROM php:8.2-cli AS php-base

# Set environment variables to avoid interactive prompts during build
ARG DEBIAN_FRONTEND=noninteractive

# Install system dependencies, libzip-dev, PHP extensions, and Node.js v16.20.2
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    curl \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libonig-dev \
    libxml2-dev \
    libicu-dev \
    libmagickwand-dev \
    libzip-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo \
        pdo_mysql \
        mysqli \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        intl \
        zip \
    && pecl install imagick \
    && docker-php-ext-enable imagick \
    # Install Node.js v16.20.2
    && curl -fsSL https://deb.nodesource.com/setup_16.x | bash - \
    && apt-get install -y --no-install-recommends nodejs=16.20.2* \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Verify Node.js and npm versions
RUN node -v && npm -v

# Install Composer (use the latest version from the official Composer image)
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory (optional, if needed)
WORKDIR /var/www/html

# Copy application files (optional, if needed for dependencies)
COPY . .

# Set proper permissions for files (optional, only if needed for shared dependencies)
RUN chown -R www-data:www-data /var/www/html \
    && find /var/www/html -type f -exec chmod 644 {} \; \
    && find /var/www/html -type d -exec chmod 755 {} \;

# No EXPOSE or ENTRYPOINT as this is a dependency image
